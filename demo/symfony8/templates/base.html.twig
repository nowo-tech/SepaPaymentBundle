{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'SEPA Payment',
    home_route: 'demo_index',
    repository: 'https://github.com/nowo-tech/SepaPaymentBundle',
    translation_domain: false,
    nav: [
        {label: 'Home', route: 'demo_index', section: 'SEPA Payment'},
        {label: 'Validation form', route: 'demo_validation_form', section: 'SEPA Payment'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}SEPA Payment Bundle Demo{% endblock %}{% endblock %}

