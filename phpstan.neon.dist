# PHPStan configuration for SEPA Payment Bundle
# Compatible with PHP 8.1+ and Symfony 6.x / 7.x / 8.x
# phpstan/extension-installer auto-includes phpstan-symfony and phpstan-phpunit

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - demo/*
        - vendor/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    # REQ-CS-006: never silence findings — fix the code instead
    ignoreErrors: []
