{
	order mercure after encode
	skip_install_trust
}

:80 {
	root * /app/public
	encode zstd br gzip
	# Worker mode (FRANKENPHP_MODE=worker, default): long-lived PHP workers; classic mode uses Caddyfile.dev.
	mercure {
		anonymous
	}

	php_server {
		hot_reload
		try_files {path} /index.php
		worker {
			file /app/public/index.php
			watch
		}
	}
}
