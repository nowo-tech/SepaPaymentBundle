{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, no inline styles). The light/dark toggle is UiKit's. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}SEPA Payment Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_index') }}">SEPA Payment Bundle</a>
        <nav class="nowo-ui-menu" aria-label="SEPA Payment Bundle">
            <a class="nowo-ui-link" href="{{ path('demo_index') }}"{% if _route == 'demo_index' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="{{ path('demo_validation_form') }}"{% if _route == 'demo_validation_form' %} aria-current="page"{% endif %}>Validation form</a>
            {% block nav_items %}{% endblock %}
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: block('header_title')}) }}
{% endblock %}

{% block header_title %}SEPA Payment Bundle Demo{% endblock %}

{% block nowo_ui_content %}{% block content %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
