{% extends 'base.html.twig' %}

{% block title %}SEPA Payment Bundle Demo{% endblock %}

{% block header_title %}Welcome{% endblock %}

{% block content %}
    <p>Welcome to the SEPA Payment Bundle demo. This demo showcases all the features of the bundle.</p>

    <h2>Available Endpoints</h2>

    <section class="nowo-ui-card">
      <div class="nowo-ui-card__body">
        <h3 class="nowo-ui-card__title">Validators</h3>
        <ul class="nowo-ui-list">
            <li><a href="{{ path('demo_validation_form') }}">📝 Validation Form (Constraints Demo)</a></li>
            <li><a href="{{ path('demo_validate_iban', {iban: 'ES9121000418450200051332'}) }}">Validate IBAN</a></li>
            <li><a href="{{ path('demo_validate_bic', {bic: 'ESPBESMM'}) }}">Validate BIC</a></li>
            <li><a href="{{ path('demo_validate_credit_card', {card: '4532015112830366'}) }}">Validate Credit Card</a></li>
            <li><a href="{{ path('demo_sepa_string_sanitizer', {input: 'José García & Company'}) }}">SEPA String Sanitizer</a></li>
            <li><a href="{{ path('demo_sepa_country_validator', {country: 'ES', iban: 'ES9121000418450200051332'}) }}">SEPA Country Validator</a></li>
            <li><a href="{{ path('demo_sepa_business_rules', {amount: '100.50', count: '1', currency: 'EUR', date: 'tomorrow'}) }}">SEPA Business Rules Validator</a></li>
        </ul>
      </div>
    </section>

    <section class="nowo-ui-card">
      <div class="nowo-ui-card__body">
        <h3 class="nowo-ui-card__title">Converters</h3>
        <ul class="nowo-ui-list">
            <li><a href="{{ path('demo_convert_ccc', {ccc: '21000418450200051332'}) }}">Convert CCC to IBAN</a></li>
        </ul>
      </div>
    </section>

    <section class="nowo-ui-card">
      <div class="nowo-ui-card__body">
        <h3 class="nowo-ui-card__title">Generators</h3>
        <ul class="nowo-ui-list">
            <li><a href="{{ path('demo_generate_identifier') }}">Generate Identifier</a></li>
            <li><a href="{{ path('demo_mandate') }}">Demo Mandate</a></li>
            <li><strong>Credit Transfer (New - Recommended):</strong></li>
            <li><a href="{{ path('demo_credit_transfer') }}">Demo Credit Transfer (with Addresses)</a></li>
            <li><a href="{{ path('demo_credit_transfer_array') }}">Demo Credit Transfer (from Array - camelCase)</a></li>
            <li><a href="{{ path('demo_credit_transfer_with_addresses') }}">Demo Credit Transfer (from Array with Addresses)</a></li>
            <li><a href="{{ path('demo_credit_transfer_snake_case') }}">Demo Credit Transfer (from Array - snake_case)</a></li>
            <li><strong>Credit Transfer (Deprecated - Still Works):</strong></li>
            <li><a href="{{ path('demo_remesa_generator_deprecated') }}">⚠️ Demo RemesaGenerator (Deprecated)</a></li>
            <li><a href="{{ path('demo_remesa_generator_array_deprecated') }}">⚠️ Demo RemesaGenerator Array (Deprecated)</a></li>
            <li><a href="{{ path('demo_comparison_deprecated_vs_new') }}">🔍 Comparison: Deprecated vs New</a></li>
            <li><strong>Direct Debit:</strong></li>
            <li><a href="{{ path('demo_direct_debit') }}">Demo Direct Debit (from Array - camelCase)</a></li>
            <li><a href="{{ path('demo_direct_debit_snake_case') }}">Demo Direct Debit (from Array - snake_case)</a></li>
            <li><a href="{{ path('demo_direct_debit_with_addresses') }}">Demo Direct Debit (from Array with Addresses)</a></li>
        </ul>
      </div>
    </section>

    <section class="nowo-ui-card">
      <div class="nowo-ui-card__body">
        <h3 class="nowo-ui-card__title">Parsers</h3>
        <ul class="nowo-ui-list">
            <li><strong>Credit Transfer Parser (New - Recommended):</strong></li>
            <li><a href="{{ path('demo_parse_credit_transfer') }}">Parse Credit Transfer XML</a></li>
            <li><strong>Credit Transfer Parser (Deprecated - Still Works):</strong></li>
            <li><a href="{{ path('demo_remesa_parser_deprecated') }}">⚠️ Parse with RemesaParser (Deprecated)</a></li>
            <li><strong>Direct Debit Parser:</strong></li>
            <li><a href="{{ path('demo_parse_direct_debit') }}">Parse Direct Debit XML</a></li>
        </ul>
      </div>
    </section>

    <section class="nowo-ui-card">
      <div class="nowo-ui-card__body">
