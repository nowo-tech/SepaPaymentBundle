{
    "name": "nowo-tech/sepa-payment-bundle",
    "description": "Symfony bundle for SEPA payment management: Generate SEPA Credit Transfer (pain.001) and Direct Debit (pain.008) XML files, IBAN/BIC validation, mandate management, ISO 20022 compliance, and banking utilities",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "php",
        "symfony",
        "symfony-bundle",
        "frankenphp",
        "sepa",
        "sepa-payment",
        "sepa-credit-transfer",
        "sepa-direct-debit",
        "iban",
        "iban-validation",
        "bic",
        "bic-validation",
        "pain.001",
        "pain.008",
        "iso20022",
        "iso-20022",
        "credit-transfer",
        "direct-debit",
        "remesas",
        "remesa-pago",
        "remesa-cobro",
        "mandatos",
        "mandate",
        "payment",
        "banking",
        "bank-transfer",
        "xml-generator",
        "ccc-to-iban",
        "credit-card-validation",
        "xsd-validation",
        "european-payments"
    ],
    "homepage": "https://github.com/nowo-tech/SepaPaymentBundle",
    "support": {
        "issues": "https://github.com/nowo-tech/SepaPaymentBundle/issues",
        "source": "https://github.com/nowo-tech/SepaPaymentBundle"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "brick/math": "^0.11 || ^0.12 || ^0.13",
        "digitick/sepa-xml": "^3.0",
        "symfony/config": "^6.0 || ^7.0 || ^8.0",
        "symfony/console": "^6.0 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.0 || ^7.0 || ^8.0",
        "symfony/translation": "^6.0 || ^7.0 || ^8.0",
        "symfony/validator": "^6.0 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.0",
        "symfony/framework-bundle": "^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\SepaPaymentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\SepaPaymentBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": ["/demo", "/.cursor"]
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "update": "composer update --no-interaction",
        "validate": "composer validate --strict",
        "qa": [
            "@cs-check",
            "@test"
        ],
        "release-check": [
            "@cs-check",
            "@rector-dry",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "phpstan": "Run PHPStan static analysis",
        "rector": "Apply Rector refactoring",
        "rector-dry": "Run Rector in dry-run mode",
        "update": "Update composer.lock (composer update)",
        "validate": "Validate composer.json (composer validate --strict)",
        "qa": "Run all quality assurance checks",
        "release-check": "Run all release checks (cs-check, rector-dry, phpstan, test)"
    }
}
