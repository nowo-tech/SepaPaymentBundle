{% extends 'base.html.twig' %}

{% block title %}SEPA Payment Bundle Demo{% endblock %}

{% block header_title %}Welcome{% endblock %}
{% block header_intro %}This demo showcases the features of the SEPA Payment Bundle. Most endpoints below answer JSON or a file; the validation form is the only page with a form.{% endblock %}

{% block content %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Validators', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a class="nowo-ui-link" href="{{ path('demo_validation_form') }}">Validation Form (Constraints Demo)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_validate_iban', {iban: 'ES9121000418450200051332'}) }}">Validate IBAN</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_validate_bic', {bic: 'ESPBESMM'}) }}">Validate BIC</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_validate_credit_card', {card: '4532015112830366'}) }}">Validate Credit Card</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_sepa_string_sanitizer', {input: 'José García & Company'}) }}">SEPA String Sanitizer</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_sepa_country_validator', {country: 'ES', iban: 'ES9121000418450200051332'}) }}">SEPA Country Validator</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_sepa_business_rules', {amount: '100.50', count: '1', currency: 'EUR', date: 'tomorrow'}) }}">SEPA Business Rules Validator</a></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Converters', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a class="nowo-ui-link" href="{{ path('demo_convert_ccc', {ccc: '21000418450200051332'}) }}">Convert CCC to IBAN</a></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Generators', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a class="nowo-ui-link" href="{{ path('demo_generate_identifier') }}">Generate Identifier</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_mandate') }}">Demo Mandate</a></li>
                <li><strong>Credit Transfer (new, recommended):</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_credit_transfer') }}">Demo Credit Transfer (with Addresses)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_credit_transfer_array') }}">Demo Credit Transfer (from Array - camelCase)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_credit_transfer_with_addresses') }}">Demo Credit Transfer (from Array with Addresses)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_credit_transfer_snake_case') }}">Demo Credit Transfer (from Array - snake_case)</a></li>
                <li><strong>Credit Transfer (deprecated, still works):</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_remesa_generator_deprecated') }}">Demo RemesaGenerator (Deprecated)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_remesa_generator_array_deprecated') }}">Demo RemesaGenerator Array (Deprecated)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_comparison_deprecated_vs_new') }}">Comparison: Deprecated vs New</a></li>
                <li><strong>Direct Debit:</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_direct_debit') }}">Demo Direct Debit (from Array - camelCase)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_direct_debit_snake_case') }}">Demo Direct Debit (from Array - snake_case)</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_direct_debit_with_addresses') }}">Demo Direct Debit (from Array with Addresses)</a></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Parsers', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><strong>Credit Transfer Parser (new, recommended):</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_parse_credit_transfer') }}">Parse Credit Transfer XML</a></li>
                <li><strong>Credit Transfer Parser (deprecated, still works):</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_remesa_parser_deprecated') }}">Parse with RemesaParser (Deprecated)</a></li>
                <li><strong>Direct Debit Parser:</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_parse_direct_debit') }}">Parse Direct Debit XML</a></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Export / Import', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><strong>Credit Transfer Export:</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_export_credit_transfer_json') }}">Export Credit Transfer to JSON</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_export_credit_transfer_csv') }}">Export Credit Transfer to CSV</a></li>
                <li><strong>Direct Debit Export:</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_export_direct_debit_json') }}">Export Direct Debit to JSON</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_export_direct_debit_csv') }}">Export Direct Debit to CSV</a></li>
                <li><strong>Import:</strong></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_import_from_json') }}">Import from JSON</a></li>
            </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Mandate Management', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a class="nowo-ui-link" href="{{ path('demo_mandate_management') }}">Mandate Management</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_mandate_lifecycle') }}">Mandate Lifecycle</a></li>
                <li><a class="nowo-ui-link" href="{{ path('demo_mandate_sequence_transitions') }}">Sequence Type Transitions</a></li>
            </ul>
        {% endblock %}
    {% endembed %}
{% endblock %}
