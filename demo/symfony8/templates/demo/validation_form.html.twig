{% extends 'base.html.twig' %}

{% block title %}SEPA Payment Validation Form Demo{% endblock %}

{% block header_title %}SEPA Payment Validation Form{% endblock %}

{% block content %}
    <p class="nowo-ui-muted">This form demonstrates the use of SEPA Payment Bundle validation constraints (Iban, Bic, SepaCountry, SepaCreditorIdentifier, CreditCard)</p>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_rest(form) }}
    {{ form_end(form, {render_rest: false}) }}

    {% if isSubmitted %}
        {% if isValid %}
            <div class="nowo-ui-flash nowo-ui-flash--success" role="status">
                <h3>Validation Successful!</h3>
                <p>All fields passed validation.</p>
                <strong>Submitted Data:</strong>
                <pre class="nowo-ui-code-block">{{ submittedData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            </div>
        {% else %}
            <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">
                <strong>Validation Failed</strong>
                <p>Please correct the errors above and try again.</p>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
