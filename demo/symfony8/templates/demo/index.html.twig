            <li><a href="{{ path('demo_import_from_json') }}">Import from JSON</a></li>
        </ul>
      </div>
    </section>

    <section class="nowo-ui-card">
      <div class="nowo-ui-card__body">
        <h3 class="nowo-ui-card__title">Mandate Management</h3>
        <ul class="nowo-ui-list">
            <li><a href="{{ path('demo_mandate_management') }}">Mandate Management</a></li>
            <li><a href="{{ path('demo_mandate_lifecycle') }}">Mandate Lifecycle</a></li>
            <li><a href="{{ path('demo_mandate_sequence_transitions') }}">Sequence Type Transitions</a></li>
        </ul>
      </div>
    </section>
{% endblock %}

