            <li><a href="{{ path('demo_export_credit_transfer_csv') }}">Export Credit Transfer to CSV</a></li>
            <li><strong>Direct Debit Export:</strong></li>
            <li><a href="{{ path('demo_export_direct_debit_json') }}">Export Direct Debit to JSON</a></li>
            <li><a href="{{ path('demo_export_direct_debit_csv') }}">Export Direct Debit to CSV</a></li>
